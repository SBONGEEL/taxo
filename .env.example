# ============================================
# TAXO — قالب الأسرار. انسخه باسم .env.local واملأ القيم.
# .env.local لا يدخل Git أبداً.
# ============================================

# ---- مدخلات seed التطوير المحلي فقط ----
# المصدر الرسمي لكل مفاتيح المزودين هو جدول provider_credentials (صفحة العقود).
# القيم أدناه يقرأها `python -m scripts.seed` مرة واحدة ليكتبها مشفّرة في القاعدة.
# مزودو SMS وFCM وpayout وCliQ تُدخل عقودهم من اللوحة مباشرة — لا مكان لهم هنا.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=
TELR_STORE_ID=
TELR_AUTH_KEY=
# حتى يصل حساب Sandbox: مزود بطاقات وهمي بلا شبكة (SPEC القسم 15).
# صريحٌ لا افتراضي، ويُتجاهل في الإنتاج.
TELR_USE_MOCK=true

# حساب المشرف الأول (اختياري — يُنشئه الـ seed خارج بيئة الإنتاج فقط)
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---- البنية التحتية ----
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://taxo:taxo@localhost:5432/taxo
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CREDENTIALS_ENCRYPTION_KEY=

# ---- FCM (إشعارات Push) ----
# **مسارٌ لا محتوى**: مفتاح RSA لا يُلصق في ملف بيئة، والملف نفسه في
# `secrets/` المُستثنى من Git. يقرؤه `python -m scripts.seed` مرةً واحدة
# فيكتبه مشفَّراً في provider_credentials، ولا يُقرأ من القرص بعدها.
FCM_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# ---- إعداد تطبيق الويب لدى Firebase (المرحلة 9) ----
# قيمٌ **عامّةٌ بطبيعتها** تُنشر في حزمة كل تطبيق ويب يستعمل Firebase، لكنها
# قيمُ مشروعٍ بعينه — فيكتبها الـ seed في عقدَي `firebase_auth` و`fcm`
# وتسلّمها الخلفية للواجهات عبر `GET /config`. تُدخل من صفحة العقود كذلك.
# مصدرها: Firebase Console ← Project settings ← General ← Your apps ← Config،
# ومفتاح VAPID من Cloud Messaging ← Web Push certificates.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_SENDER_ID=
FIREBASE_WEB_VAPID_KEY=

# ---- طبقةُ النفق على جهازٍ لينكسيّ (`docker-compose.tunnel.yml`) ----
# **يُتركان فارغين على ويندوز** — فالاحتياطُ فيهما هو السلوكُ القديمُ حرفاً،
# ومن لا يصرّحهما هناك لا يتغيّر عنده شيء. وفي لينكس بلا تصريحٍ يسقط النفق:
#
#  ١) `USERPROFILE` متغيّرُ ويندوز، وغيابُه يجعل مسارَ الاعتماد `/.cloudflared`.
#  ٢) وصورةُ `cloudflared` تعمل بمستخدم 65532، واعتمادُ النفق `600` ومجلَّدُه
#     `700` بملك المستخدم — فلا يقرؤه، ويخرج بـ1 قائلاً «الملفُّ غيرُ موجود»
#     وهو موجود. **ولا تُرخى صلاحيةُ سرٍّ لأجل حاوية**، فيُصرَّح المستخدم.
#
# مثالٌ في لينكس:  TAXO_CLOUDFLARED_DIR=$HOME/.cloudflared   و  TAXO_TUNNEL_USER=1000:1000
TAXO_CLOUDFLARED_DIR=
TAXO_TUNNEL_USER=
