# ============================================
# TAXO — قالب الأسرار. انسخه باسم .env.local واملأ القيم.
# .env.local لا يدخل Git أبداً.
# ============================================

# ---- Mapbox (للـ seed المحلي فقط — المصدر الرسمي هو صفحة العقود) ----
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SECRET_TOKEN=

# ---- Telr Sandbox ----
TELR_STORE_ID=
TELR_AUTH_KEY=

# ---- مزود SMS (فارغ = دخول بكلمة مرور، معبّأ = OTP) ----
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- FCM ----
FCM_SERVICE_ACCOUNT_JSON_PATH=

# ---- البنية التحتية ----
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://taxo:taxo@localhost:5432/taxo
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=taxo
POSTGRES_PASSWORD=taxo
POSTGRES_DB=taxo
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CREDENTIALS_ENCRYPTION_KEY=
