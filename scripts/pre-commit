#!/usr/bin/env bash
# **الطبقةُ الثانية**: يرفض إيداعاً يحمل مساراً محظوراً — **ويسمّي الملفّ**.
#
# **العلّةُ مقيسةٌ ثلاثَ مرّات** (قرارُ المالك 2026-08-23): `git add -A` ابتلع
# ملفَّي كلمةِ مرورٍ ورمز، وكاد يبتلع `car/`. **والطبقةُ الأولى `.gitignore`
# تمنع الابتلاعَ الصامت** — لكنها لا تمنع `git add -f`، ولا تمنع مساراً لم
# يخطر ببال من كتبها. **وهذا يقيس ما يُودَع فعلاً**، فيمسك ما تسلّل من أيِّ
# طريق.
#
# **ولمَ طبقتان لا واحدة**: الأولى تمنع فلا يبلغ أحدٌ لحظةَ الخطّاف، والثانية
# تكشف ما بلغها. وواحدةٌ منهما وحدَها **تعتمد على ألّا يُخطئ أحد** — وقد أخطأ
# ثلاثاً.
#
# **ولا يعترض أسماءَ ملفّات المشروع العادية**: القوائمُ أدناه **لواحقُ سرٍّ
# ومجلّداتُ مادّةٍ خام**، لا كلماتٌ عامّةٌ تقع في أسماءِ كودٍ مشروعة. حارسٌ
# يصيح على السليم يُطفأ، فيسقط معه ما يمسكه حقاً.
#
# **ويُقاس في الاتجاهين قبل أن يُصدَّق** — كعادة المشروع.
#
# التركيب:  git config core.hooksPath scripts
set -uo pipefail

# ملفّاتُ الفهرس — بأسماءٍ خام (`-z`) كي لا تُقطع مساراتٌ فيها مسافاتٌ أو عربية
mapfile -d '' staged < <(git diff --cached --name-only -z --diff-filter=ACMR)
[ ${#staged[@]} -eq 0 ] && exit 0

blocked=()

for path in "${staged[@]}"; do
  case "$path" in
    # ── مادّةٌ خامٌ تنتظر عينَ المالك (§28.8) ──────────────────────────────
    car/*)
      blocked+=("$path — مادّةٌ خامٌ تنتظر فحصَ §28.8 (شعارٌ أو اسمُ صانع)") ;;

    # ── أسرارٌ: اللاحقةُ هي المعيار لا الكلمة ──────────────────────────────
    *.pem|*.key|*.p12|*.pfx|*.jks|*.keystore)
      blocked+=("$path — مفتاحٌ أو شهادة") ;;
    *id_rsa|*id_ed25519)
      blocked+=("$path — مفتاحُ SSH خاصّ") ;;
    .env|.env.*|*/.env|*/.env.*)
      # `.env.example` قالبٌ بلا قيم — وهو المستثنى الوحيد
      case "$path" in *.example) ;; *) blocked+=("$path — ملفُّ بيئةٍ يحمل قيماً") ;; esac ;;
    secrets/*|*/secrets/*)
      blocked+=("$path — مجلَّدُ أسرار") ;;
    google-services*.json)
      blocked+=("$path — إعدادُ Firebase لحزمةٍ بعينها") ;;
    *credentials.json|*creds.json)
      blocked+=("$path — بيانُ اعتماد") ;;
  esac
done

if [ ${#blocked[@]} -gt 0 ]; then
  printf '\n✗ إيداعٌ يحمل مساراً محظوراً — %d ملفّاً:\n' "${#blocked[@]}" >&2
  for line in "${blocked[@]}"; do printf '   %s\n' "$line" >&2; done
  printf '\n  أخرِجْه من الفهرس:  git restore --staged <الملفّ>\n' >&2
  printf '  ولا يُتجاوَز هذا بـ`--no-verify` إلا بقرارٍ صريحٍ من المالك.\n\n' >&2
  exit 1
fi

exit 0
