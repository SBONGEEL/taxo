<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleDisplayName</key>
	<string>$(TAXO_APP_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- **نصوصُ الأذونات من المالك حرفاً** (٢٠٢٦-٠٩-٢٩) — ولا UIBackgroundModes
	     قبل ملحق الموقع الخلفيّ: إعلانٌ بلا فعلٍ يُرفض في المراجعة ويكذب. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>يحتاج TAXO موقعك لتحديد نقطة الانطلاق وعرض الكباتن القريبين منك.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>لتسجيل الدخول السريع ببصمة الوجه بدل كتابة كلمة المرور.</string>
	<key>NSCameraUsageDescription</key>
	<string>لتصوير صورتك الشخصية، ولمسح رمز QR لبطاقة TAXO عند الشحن.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>لاختيار الصورة الشخصية والوثائق من صورك.</string>
	<!-- **زرُّ التبديل** (SPEC §23): يستقبل مخطّطَه، ويُصرِّح بمخطّط أخيه
	     ليُجيب canOpenURL — وبغيره يعيد النظامُ false عن تطبيقٍ مثبَّت. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>taxo-rider</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>taxo-rider</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>taxo-driver</string>
	</array>
	<!-- **إضافاتُ iOS (أمرُ المالك ٢٠٢٦-١١-١٧)** — كلُّ مفتاحٍ هنا يقابله فعلٌ في الشيفرة لا إعلانٌ بلا فعل:
	     مراجعةُ Apple ترفض وضعَ خلفيّةٍ أو إذناً لا يُستعمل (Guideline 2.5.4 · 5.1.1). -->
	<key>TaxoAppKind</key>
	<string>rider</string>
	<key>TaxoCallKit</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>fr</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>للمكالمة الصوتية مع الكبتن داخل التطبيق وللبحث بالصوت.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>لتحويل ما تقوله إلى نصٍّ حين تبحث عن وجهتك بالصوت.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>/wallet</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>المحفظة</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>creditcard</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>/rides</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>رحلاتي</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>clock.arrow.circlepath</string>
		</dict>
	</array>
</dict>
</plist>
