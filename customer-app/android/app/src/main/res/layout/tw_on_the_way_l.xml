            <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
                <ImageView android:id="@+id/tw_photo" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/tw_v_person_mut" android:scaleType="centerCrop" android:importantForAccessibility="no" />
