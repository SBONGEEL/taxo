            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/tw_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="15sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="السائق في الطريق" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="4dp" android:src="@drawable/tw_v_star_star" android:scaleType="fitCenter" android:importantForAccessibility="no" />
