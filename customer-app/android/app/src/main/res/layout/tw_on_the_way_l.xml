<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <ImageView android:id="@+id/tw_map" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/tw_carbox" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <ImageView android:id="@+id/tw_car" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_marginTop="56dp" android:layout_marginEnd="14dp" android:layout_marginBottom="124dp" android:src="@drawable/tw_car_economy" android:scaleType="fitEnd" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/tw_live" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp" android:visibility="gone" android:orientation="vertical">
        <LinearLayout android:id="@+id/tw_chip" android:layout_width="wrap_content" android:layout_height="34dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingTop="0dp" android:paddingEnd="12dp" android:paddingBottom="0dp" android:background="@drawable/tw_chip" android:orientation="horizontal">
