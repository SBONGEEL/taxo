                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/tw_bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginStart="4dp" android:layout_marginTop="10dp" android:layout_marginEnd="4dp" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:progressDrawable="@drawable/tw_bar" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tw_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="14dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="14dp" android:orientation="vertical">
        <TextView android:id="@+id/tw_e_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="15sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="السائق في الطريق" />
