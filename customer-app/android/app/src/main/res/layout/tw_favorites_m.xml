        <LinearLayout android:id="@+id/tw_btn" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="14dp" android:paddingBottom="0dp" android:background="@drawable/tw_pill_glass" android:orientation="horizontal">
