                <FrameLayout android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" />
                <LinearLayout android:id="@+id/tw_btn" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:layout_marginTop="8dp" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="14dp" android:paddingBottom="0dp" android:background="@drawable/tw_pill" android:orientation="horizontal">
