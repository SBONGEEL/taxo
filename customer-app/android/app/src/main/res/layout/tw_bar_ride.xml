<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ TAXO «bar_ride»** — مولَّدٌ من tools/gen-android-widgets.py — لا يُحرَّر باليد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingTop="6dp" android:paddingEnd="4dp" android:paddingBottom="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tw_tx" android:textSize="15sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="اطلب رحلة" />
                <ImageView android:layout_width="wrap_content" android:layout_height="11dp" android:src="@drawable/tw_wordmark" android:scaleType="fitCenter" android:adjustViewBounds="true" android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/tw_t0" android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:paddingStart="12dp" android:paddingTop="0dp" android:paddingEnd="12dp" android:paddingBottom="0dp" android:background="@drawable/tw_pill_glass" android:orientation="horizontal">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="5dp" android:src="@drawable/tw_g_home" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/tw_t0l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="المنزل" />
                </LinearLayout>
                <LinearLayout android:id="@+id/tw_t1" android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:layout_marginStart="6dp" android:paddingStart="12dp" android:paddingTop="0dp" android:paddingEnd="12dp" android:paddingBottom="0dp" android:background="@drawable/tw_pill_glass" android:orientation="horizontal">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="5dp" android:src="@drawable/tw_g_work" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/tw_t1l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="12sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="العمل" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="96dp" android:layout_height="match_parent">
            <ImageView android:id="@+id/tw_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tw_scene" android:scaleType="fitEnd" android:importantForAccessibility="no" android:alpha="0.8" />
            <ImageView android:id="@+id/tw_car" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:src="@drawable/tw_car_economy" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
