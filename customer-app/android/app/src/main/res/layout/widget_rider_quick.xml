<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ الراكب** (أمرُ المالك ٢٠/١١ الرابع، الجزء ٣) — «إلى أين؟» · البيت والعمل · الوجهاتُ الأخيرة · حالُ الرحلة.
     كلُّ زرٍّ يفتح التطبيقَ للتأكيد — **لا رحلةَ تُطلب من الودجة أبداً**. نهارٌ وليلٌ من values/values-night. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/w2_bg">

    <TextView
        android:id="@+id/rq_where"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical|start"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="إلى أين؟"
        android:textColor="@color/w2_tx"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/w2_chip" />

    <LinearLayout
        android:id="@+id/rq_places"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/rq_home"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="البيت"
            android:textColor="@color/w2_inv"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/w2_btn" />
        <TextView
            android:id="@+id/rq_work"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="العمل"
            android:textColor="@color/w2_inv"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/w2_btn" />
    </LinearLayout>

    <TextView
        android:id="@+id/rq_recent0"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/w2_tx"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/rq_recent1"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/w2_tx"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/rq_recent2"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/w2_tx"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rq_ride"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="10dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/w2_tx"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/w2_chip" />
</LinearLayout>
