<?xml version="1.0" encoding="utf-8"?>
<!-- **قبل الدخول** في ودجات الأمر الثامن — البطاقةُ نفسُها التي يملؤها `WidgetSignedOut` (الشعار وسطرٌ وزرّ). مولَّد. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wo_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center" android:padding="12dp" android:background="@drawable/tw_bg" android:visibility="gone">
    <LinearLayout android:id="@+id/wo_col" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@mipmap/ic_launcher_round" android:contentDescription="TAXO" />
        <TextView android:id="@+id/wo_mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="19sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="6dp" android:letterSpacing="0.08" android:text="TAXO"/>
        <TextView android:id="@+id/wo_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="13sp" android:includeFontPadding="false" android:layout_marginTop="2dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/wo_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="10dp" android:minWidth="160dp" android:minHeight="40dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@drawable/tw_btn"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/wo_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@mipmap/ic_launcher_round" android:contentDescription="TAXO" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/wo_mark2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false" android:letterSpacing="0.08" android:text="TAXO"/>
            <TextView android:id="@+id/wo_line2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/wo_btn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" android:minHeight="36dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/tw_btn"/>
    </LinearLayout>
</LinearLayout>
