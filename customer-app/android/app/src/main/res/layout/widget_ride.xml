<?xml version="1.0" encoding="utf-8"?>
<!-- أداةُ «اطلب رحلة» (SPEC §١٠٣ B/20) — زرّان إلى «البيت» و«العمل» المحفوظين، ولا حسابَ هنا ولا نداء -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ride_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/ride_widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="اطلب رحلة"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ride_widget_home"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="البيت"
        android:textColor="#FF1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button" />

    <TextView
        android:id="@+id/ride_widget_work"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:minWidth="64dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="العمل"
        android:textColor="#FF1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button" />
</LinearLayout>
