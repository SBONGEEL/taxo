<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:paddingStart="12dp" android:paddingTop="14dp" android:paddingEnd="12dp" android:paddingBottom="12dp" android:orientation="vertical">
        <ImageView android:layout_width="wrap_content" android:layout_height="13dp" android:src="@drawable/tw_wordmark" android:scaleType="fitCenter" android:adjustViewBounds="true" android:importantForAccessibility="no" />
