<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!-- **رؤيةُ الحزم على أندرويد ١١ فما فوق** (قِيس على S21، أندرويد ١٥):
         بلا هذا يعيد `canOpenUrl` **false لتطبيقٍ مثبَّتٍ فعلاً** — النظامُ
         يُخفي الحزمَ الأخرى عن التطبيق ما لم يعلن أنه يسألها. وهو عطبٌ صامت:
         لا استثناءَ ولا سطرَ سجلّ، فيُقرأ «غير مثبَّت» عن مثبَّت.

         والإعلانُ **بالحزمة وبالمخطط معاً**: الأولُ يكفي وهو الأضيق، والثاني
         يبقي الفحصَ عاملاً لو تبدّل اسمُ الحزمة يوماً. -->
    <queries>
        <package android:name="ly.tajora.driver" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taxo-driver" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- **رأسيٌّ وحدَه** (قرارُ المالك 2026-08-23، تطبيقُ الراكب دون غيره).
             والعلّةُ مقيسةٌ لا مذهبٌ في التصميم: على إطارٍ ٨٠٠×٣٦٠ يصير سقفُ
             الورقة ١٩٢ بكسلاً، **والقدمُ الثابتةُ وحدَها ١٨٠** — فمنطقةُ
             التمرير ارتفاعُها **صفر**. أي أن المبلغَ والزرَّ يُرَيان (الشرطُ
             الصلبُ مستوفىً) **بينما المسارُ والمحطاتُ والفئةُ والكوبونُ بلا
             مساحةٍ تُرى فيها**. ولا يُنقذه تصغيرُ الحجز: ٣٦٠ ناقصَ قدمٍ ١٨٠
             لا يترك شاشةً صالحة.
             **ولا يُنسخ هذا إلى تطبيق الكبتن**: هاتفُه يُثبَّت أفقياً في
             السيارة، وكاميرا الملاحة قادمة — فالأفقيُّ هناك **يُقاس قبل أن
             يُقرَّر** (بندٌ مستقلٌّ في `HANDOFF.md`). -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- **بابُ استقبال الجلسة المنقولة** (SPEC §23).

                 ومخططٌ خاصٌّ لا رابطُ تطبيق (App Link): الأخيرُ يحتاج ملفَّ
                 `assetlinks.json` على النطاق وتوقيعَ إصدارٍ مستقرّاً، وكلاهما
                 بندُ ما قبل الإطلاق (§18.1). والمرسِلُ يثبّت الحزمةَ في نيّته
                 (`package=`)، فلا يلتقط الرمزَ تطبيقٌ سجّل المخططَ نفسَه.

                 و`android:launchMode="singleTask"` أعلاه هو ما يجعل النيّةَ
                 تصل نشاطاً قائماً بدل أن تُنشئ ثانياً فوقه. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="taxo-rider" android:host="handoff" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- **قناةُ الافتراض** (SPEC §٦١-ل/٣): ما يصل بلا قناةٍ أو بقناةٍ لم تُنشأ
             يقع فيها بصوت «الإشعار» — **وكان يقع في احتياطية FCM بصوت الهاتف**.
             تُنشئها `TaxoChannels` عند الإقلاع. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="taxo.general" />

        <!-- **وأيقونةُ ما يرسمه النظامُ والتطبيقُ في الخلفية** (§٦٦-ج/١٧، ٢٠٢٦-١٠-٠٩): بلاها يرسم FCM أيقونةَ التشغيل،
             **والتكيّفيّةُ منها تُسقط واجهةَ النظام على أندرويد ٨٫٠** — وملوّنةٌ تُرسم مربّعاً أبيض فيما بعده. فالأحاديّةُ اللون
             نفسُها التي يرسم بها `CallAlert` (`drawable/ic_stat_taxo.xml`) — **مكتوبةٌ ولم تُرَ على هاتفٍ بعد**. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_taxo" />

        <!-- **رنينُ المكالمة والتطبيقُ مغلق** (§٦٦-ج/١٧، الحزمةُ «2.0» — **مكتوبٌ ولم يُقَس على هاتفٍ بعد**).
             **خدمةُ رسائلَ واحدةٌ لا اثنتان**: خدمةُ ملحق الإشعارات تُنزع هنا (`tools:node="remove"`)، **و`CallMessagingService`
             ترثها** وتمرّر كلَّ رسالةٍ إلى `super` — فما يصل الويبَ اليومَ يصله حرفاً، وتزيد هي رسمَ `incoming_call`
             (بياناتٍ وحدَها، على `taxo.call`) وطيَّه بـ`call_ring_stopped`. **وخدمتان على المرشّح نفسِه تُسقط إحداهما
             الأخرى فتنقطع كلُّ إشعارات التطبيق** — فالنزعُ والتسجيلُ يُضافان ويُنزعان معاً. -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />
        <service
            android:name=".CallMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- **«رفض» على إشعار الرنين** — يطويه على الجهاز وحدَه (`CallDeclineReceiver`)، ولا يفتح شيئاً. -->
        <receiver
            android:name=".CallDeclineReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- الموقع: **دقيقٌ وتقريبيٌّ معاً**. أندرويد 12+ يعطي المستخدمَ خيارَ
         «تقريبي» ولو طلبتَ الدقيق، فطلبُ الدقيق وحدَه يجعل من اختار التقريبيَّ
         بلا موقعٍ إطلاقاً — لا بموقعٍ أخشن. والراكبُ يحتاجه لنقطة الانطلاق. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- الإشعارات: إذنٌ صريحٌ منذ أندرويد 13 (API 33). ولا يُطلب عند الإقلاع
         بل عند أول حدثٍ يستحقّه — وطلبُه على شاشةٍ فارغةٍ يُرفض ثم لا يُسأل ثانية. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- **المكالمةُ داخل الرحلة** (SPEC §٦٦-ج، §٦٦-د/٨ — أُضيف ٢٠٢٦-١٠-٠٨، **ولم تُبنَ بها حزمةٌ بعد**).
         **العلّةُ مقيسة**: لا `RECORD_AUDIO` في أيِّ حزمةٍ مثبَّتة، فالويب‌فيو لا يبلغ الميكروفون — و`getUserMedia` تُرفض عند
         النداء. والغلافُ (`BridgeWebChromeClient`) يطلب الإذنَ عند أوّل مكالمةٍ لا عند الإقلاع. **و`MODIFY_AUDIO_SETTINGS`** يطلبه
         الويب‌فيو مع الصوت ليضبط مجرى المكالمة. **وزرُّ «اتصال» لا يظهر في غلافٍ لا يحمل علامتَهما في وكيل المستخدم**
         (`capacitor.config.ts → android.appendUserAgent` = `src/lib/mic-gate.ts → CALLS_SHELL_MARK`) — لا رقمَ بناء: الرقمُ عددُ
         إيداعاتِ الفرع فلا يفصل حزمةً فيها الإذنُ عن أخرى. **والعلامةُ والإذنُ يُضافان ويُنزعان معاً**، ويقيسهما
         `tools/check-mic-gate.mjs`. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- **رنينُ المكالمة يملأ الشاشة** (§٦٦-ج/١٧، الحزمةُ «2.0»): **أندرويد ١٤ فما فوق ينزع منحَه تلقائياً عن غير المكالمات
         والمنبّهات — وهذه مكالمة**؛ فالتصريحُ لا يكفي، ويُسأل `canUseFullScreenIntent` حيّاً (`CallAlert`). ومن لم يُمنحه يصله
         الإشعارُ نفسُه يرنّ بلا ملء شاشة. **وكانت الخطّةُ هنا تعليقاً** («مُخطَّطٌ لا مكتوب») — والمبنيُّ وحدودُه في رأس
         `CallAlert.java`، والخادمُ في `services/push/channels.py`. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>
