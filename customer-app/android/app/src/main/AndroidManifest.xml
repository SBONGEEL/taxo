<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- **بابُ استقبال الجلسة المنقولة** (SPEC §23).

                 ومخططٌ خاصٌّ لا رابطُ تطبيق (App Link): الأخيرُ يحتاج ملفَّ
                 `assetlinks.json` على النطاق وتوقيعَ إصدارٍ مستقرّاً، وكلاهما
                 بندُ ما قبل الإطلاق (§18.1). والمرسِلُ يثبّت الحزمةَ في نيّته
                 (`package=`)، فلا يلتقط الرمزَ تطبيقٌ سجّل المخططَ نفسَه.

                 و`android:launchMode="singleTask"` أعلاه هو ما يجعل النيّةَ
                 تصل نشاطاً قائماً بدل أن تُنشئ ثانياً فوقه. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="taxo-rider" android:host="handoff" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- الموقع: **دقيقٌ وتقريبيٌّ معاً**. أندرويد 12+ يعطي المستخدمَ خيارَ
         «تقريبي» ولو طلبتَ الدقيق، فطلبُ الدقيق وحدَه يجعل من اختار التقريبيَّ
         بلا موقعٍ إطلاقاً — لا بموقعٍ أخشن. والراكبُ يحتاجه لنقطة الانطلاق. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- الإشعارات: إذنٌ صريحٌ منذ أندرويد 13 (API 33). ولا يُطلب عند الإقلاع
         بل عند أول حدثٍ يستحقّه — وطلبُه على شاشةٍ فارغةٍ يُرفض ثم لا يُسأل ثانية. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
