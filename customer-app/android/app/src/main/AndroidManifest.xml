<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- **رؤيةُ الحزم على أندرويد ١١ فما فوق** (قِيس على S21، أندرويد ١٥):
         بلا هذا يعيد `canOpenUrl` **false لتطبيقٍ مثبَّتٍ فعلاً** — النظامُ
         يُخفي الحزمَ الأخرى عن التطبيق ما لم يعلن أنه يسألها. وهو عطبٌ صامت:
         لا استثناءَ ولا سطرَ سجلّ، فيُقرأ «غير مثبَّت» عن مثبَّت.

         والإعلانُ **بالحزمة وبالمخطط معاً**: الأولُ يكفي وهو الأضيق، والثاني
         يبقي الفحصَ عاملاً لو تبدّل اسمُ الحزمة يوماً. -->
    <queries>
        <package android:name="ly.tajora.driver" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taxo-driver" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- **رأسيٌّ وحدَه** (قرارُ المالك 2026-08-23، تطبيقُ الراكب دون غيره).
             والعلّةُ مقيسةٌ لا مذهبٌ في التصميم: على إطارٍ ٨٠٠×٣٦٠ يصير سقفُ
             الورقة ١٩٢ بكسلاً، **والقدمُ الثابتةُ وحدَها ١٨٠** — فمنطقةُ
             التمرير ارتفاعُها **صفر**. أي أن المبلغَ والزرَّ يُرَيان (الشرطُ
             الصلبُ مستوفىً) **بينما المسارُ والمحطاتُ والفئةُ والكوبونُ بلا
             مساحةٍ تُرى فيها**. ولا يُنقذه تصغيرُ الحجز: ٣٦٠ ناقصَ قدمٍ ١٨٠
             لا يترك شاشةً صالحة.
             **ولا يُنسخ هذا إلى تطبيق الكبتن**: هاتفُه يُثبَّت أفقياً في
             السيارة، وكاميرا الملاحة قادمة — فالأفقيُّ هناك **يُقاس قبل أن
             يُقرَّر** (بندٌ مستقلٌّ في `HANDOFF.md`). -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- **بابُ استقبال الجلسة المنقولة** (SPEC §23).

                 ومخططٌ خاصٌّ لا رابطُ تطبيق (App Link): الأخيرُ يحتاج ملفَّ
                 `assetlinks.json` على النطاق وتوقيعَ إصدارٍ مستقرّاً، وكلاهما
                 بندُ ما قبل الإطلاق (§18.1). والمرسِلُ يثبّت الحزمةَ في نيّته
                 (`package=`)، فلا يلتقط الرمزَ تطبيقٌ سجّل المخططَ نفسَه.

                 و`android:launchMode="singleTask"` أعلاه هو ما يجعل النيّةَ
                 تصل نشاطاً قائماً بدل أن تُنشئ ثانياً فوقه. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="taxo-rider" android:host="handoff" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- الموقع: **دقيقٌ وتقريبيٌّ معاً**. أندرويد 12+ يعطي المستخدمَ خيارَ
         «تقريبي» ولو طلبتَ الدقيق، فطلبُ الدقيق وحدَه يجعل من اختار التقريبيَّ
         بلا موقعٍ إطلاقاً — لا بموقعٍ أخشن. والراكبُ يحتاجه لنقطة الانطلاق. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- الإشعارات: إذنٌ صريحٌ منذ أندرويد 13 (API 33). ولا يُطلب عند الإقلاع
         بل عند أول حدثٍ يستحقّه — وطلبُه على شاشةٍ فارغةٍ يُرفض ثم لا يُسأل ثانية. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
