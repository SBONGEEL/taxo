{
  "name": "taxo-driver-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:scale && npm run check:enums && npm run check:digits && npm run check:slot && npm run check:config && npm run check:target && npm run check:contract && tsc -b && vite build && npm run check:dist && npm run check:served",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "check:scale": "node scripts/check-scale.mjs",
    "check:enums": "node scripts/check-enums.mjs",
    "check:slot": "node scripts/check-slot.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:target": "node scripts/check-dist-target.mjs --intent",
    "check:dist": "node scripts/check-dist-target.mjs --dist",
    "check:digits": "node scripts/check-digits.mjs",
    "check:contract": "node ../tools/check-contract.mjs --app driver-app",
    "check:served": "node ../tools/check-served.mjs driver-app"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/app-launcher": "^7.0.4",
    "@capacitor/core": "^7.6.8",
    "@capacitor/geolocation": "^7.1.8",
    "clsx": "^2.1.1",
    "firebase": "^11.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "mapbox-gl": "^3.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
