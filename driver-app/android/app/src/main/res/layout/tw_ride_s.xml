<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ TAXO «ride_s»** — مولَّدٌ من tools/gen-android-widgets.py — لا يُحرَّر باليد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/tw_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="7dp" android:src="@drawable/tw_dot_ok" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tw_tx" android:textSize="13.5sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="رحلتي الحالية" />
        </LinearLayout>
        <TextView android:id="@+id/tw_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/tw_mut" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:text="لا رحلة الآن" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/tw_car" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tw_car_economy" android:scaleType="fitEnd" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:id="@+id/tw_btn" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:layout_marginTop="6dp" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="14dp" android:paddingBottom="0dp" android:background="@drawable/tw_pill" android:visibility="gone" android:orientation="horizontal">
            <TextView android:id="@+id/tw_btn_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="12.5sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="افتح الرحلة" />
            <ImageView android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="8dp" android:src="@drawable/tw_v_arrow_on" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
