<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجاتُ TAXO** (أمرُ المالك ٢٠/١١ الثامن) — تخطيطٌ واحدٌ لكلِّ الأنواع، والنوعُ يُظهر ما يحتاجه. **لا رحلةَ من الودجة**:
     كلُّ زرٍّ يفتح التطبيق، والراكبُ يؤكّد في ورقة الطلب. نهارٌ وليلٌ من values/values-night، **وزجاجٌ بالتدرّجات بلا blur**. مولَّد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="@drawable/tw_bg">

    <ImageView android:id="@+id/tw_car" android:layout_width="176dp" android:layout_height="110dp" android:layout_gravity="bottom|left"
        android:layout_marginLeft="-6dp" android:scaleType="fitCenter" android:visibility="gone" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/tw_car_s" android:layout_width="124dp" android:layout_height="78dp" android:layout_gravity="bottom|left"
        android:layout_marginLeft="4dp" android:layout_marginBottom="26dp" android:scaleType="fitCenter" android:visibility="gone" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/tw_art" android:layout_width="92dp" android:layout_height="92dp" android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="22dp" android:visibility="gone" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/tw_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/tw_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="7dp" android:src="@drawable/tw_dot" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tw_mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" android:letterSpacing="0.06" android:visibility="gone" android:text="TAXO"/>
            <TextView android:id="@+id/tw_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="15sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"/>
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:id="@+id/tw_icon" android:layout_width="22dp" android:layout_height="22dp" android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tw_bigrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:orientation="horizontal" android:gravity="bottom" android:visibility="gone">
            <TextView android:id="@+id/tw_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="32sp" android:textStyle="bold" android:includeFontPadding="false" android:textDirection="ltr"/>
            <TextView android:id="@+id/tw_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="13sp" android:includeFontPadding="false" android:layout_marginStart="6dp" android:layout_marginBottom="3dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tw_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="12.5sp" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:visibility="gone"/>
        <LinearLayout android:id="@+id/tw_tiles" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="10dp" android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:id="@+id/tw_t0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/tw_chip" android:visibility="gone">
                <ImageView android:id="@+id/tw_t0i" android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tw_t0l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tw_t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tw_chip" android:visibility="gone">
                <ImageView android:id="@+id/tw_t1i" android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tw_t1l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tw_t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tw_chip" android:visibility="gone">
                <ImageView android:id="@+id/tw_t2i" android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tw_t2l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/tw_t3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/tw_chip" android:visibility="gone">
                <ImageView android:id="@+id/tw_t3i" android:layout_width="28dp" android:layout_height="28dp" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tw_t3l" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="12sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/tw_fill" android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/tw_actions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/tw_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" android:minHeight="36dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/tw_btn" android:visibility="gone"/>
            <TextView android:id="@+id/tw_btn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="13.5sp" android:textStyle="bold" android:includeFontPadding="false" android:minHeight="34dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp" android:background="@drawable/tw_btn2" android:visibility="gone"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/tw_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="10dp" android:max="100" android:progressDrawable="@drawable/tw_bar" android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:id="@+id/tw_ringbox" android:layout_width="132dp" android:layout_height="132dp" android:layout_gravity="center" android:visibility="gone">
        <ProgressBar android:id="@+id/tw_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent"
            android:max="100" android:progressDrawable="@drawable/tw_ring" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/tw_ring_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/tw_g_star" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tw_ring_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="26sp" android:textStyle="bold" android:includeFontPadding="false" android:textDirection="ltr"/>
            <TextView android:id="@+id/tw_ring_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="11sp" android:includeFontPadding="false" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/tw_quick" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingTop="14dp" android:visibility="gone">
        <TextView android:id="@+id/tw_qmark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="17sp" android:textStyle="bold" android:includeFontPadding="false" android:letterSpacing="0.06" android:text="TAXO"/>
        <TextView android:id="@+id/tw_qtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="4dp" android:text="طلب سريع"/>
        <ImageView android:id="@+id/tw_qbtn" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginTop="10dp" android:padding="14dp"
            android:background="@drawable/tw_circle" android:src="@drawable/tw_g_local_taxi_on" android:contentDescription="اطلب رحلة" />
    </LinearLayout>

    <LinearLayout android:id="@+id/tw_place" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center" android:visibility="gone">
        <ImageView android:id="@+id/tw_place_icon" android:layout_width="64dp" android:layout_height="64dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tw_place_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tw_place_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <include layout="@layout/tw_signed_out" />
</FrameLayout>
