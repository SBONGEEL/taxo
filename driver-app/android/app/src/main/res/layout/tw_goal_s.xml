<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ TAXO «goal_s»** — مولَّدٌ من tools/gen-android-widgets.py — لا يُحرَّر باليد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="7dp" android:src="@drawable/tw_g_flag" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tw_tx" android:textSize="13sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="هدفي اليوميّ" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center">
            <FrameLayout android:layout_width="104dp" android:layout_height="104dp">
                <ProgressBar android:id="@+id/tw_ring" android:layout_gravity="center" android:layout_width="104dp" android:layout_height="104dp" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:progressDrawable="@drawable/tw_ring" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/tw_g_flag" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/tw_ring_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/tw_tx" android:textSize="18sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <TextView android:id="@+id/tw_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:gravity="center" android:text="حدّد هدفَك من إعدادات الفقاعة" />
    </LinearLayout>
</FrameLayout>
