<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ الكبتن** (أمرُ المالك ٢٠/١١ الرابع، الجزء ٣) — صغيرة: الحالُ وزرُّها؛ متوسّطة: + أرقامُ اليوم والحلقتان؛ كبيرة: + المنطقةُ والرحلة.
     النصوصُ والأرقامُ من التطبيق (الويب أو الفقاعة)، ولا حسابَ هنا. نهارٌ وليلٌ من values/values-night. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/w2_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/w2_ring"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="حلقة الهدف والاشتراك" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAXO"
                android:textColor="@color/w2_tx"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w2_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="—"
                android:textColor="@color/w2_mut"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/w2_toggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="76dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="اتّصل"
            android:textColor="@color/w2_inv"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/w2_btn" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w2_busy_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/w2_chip">
        <TextView
            android:id="@+id/w2_busy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—"
            android:textColor="@color/w2_tx"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w2_busy_go"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="اذهب إليها"
            android:textColor="@color/w2_inv"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/w2_btn" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w2_ride_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/w2_chip">
        <TextView
            android:id="@+id/w2_ride"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—"
            android:textColor="@color/w2_tx"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w2_call"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="اتصال"
            android:textColor="@color/w2_inv"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/w2_btn" />
    </LinearLayout>
</LinearLayout>
