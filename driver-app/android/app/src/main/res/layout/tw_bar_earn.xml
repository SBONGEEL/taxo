<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ TAXO «bar_earn»** — مولَّدٌ من tools/gen-android-widgets.py — لا يُحرَّر باليد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:id="@+id/tw_dot" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="7dp" android:src="@drawable/tw_dot_off" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tw_tx" android:textSize="14.5sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="غير متّصل" />
            </LinearLayout>
            <LinearLayout android:id="@+id/tw_bigrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:layout_marginTop="3dp" android:visibility="gone" android:orientation="horizontal">
                <TextView android:id="@+id/tw_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="19sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
                <TextView android:id="@+id/tw_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="2dp" android:textColor="@color/tw_mut" android:textSize="12sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/tw_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/tw_mut" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:text="أرباحُ اليوم ورحلاتُه في التطبيق" />
        </LinearLayout>
        <FrameLayout android:layout_width="96dp" android:layout_height="match_parent">
            <ImageView android:id="@+id/tw_scene" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/tw_scene" android:scaleType="fitEnd" android:importantForAccessibility="no" android:alpha="0.8" />
            <ImageView android:id="@+id/tw_car" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:src="@drawable/tw_car_economy" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:id="@+id/tw_btn" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center" android:layout_marginStart="4dp" android:paddingStart="16dp" android:paddingTop="0dp" android:paddingEnd="14dp" android:paddingBottom="0dp" android:background="@drawable/tw_pill" android:orientation="horizontal">
            <TextView android:id="@+id/tw_btn_t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="13sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="اتّصل" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
