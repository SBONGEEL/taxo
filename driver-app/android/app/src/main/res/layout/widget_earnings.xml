<?xml version="1.0" encoding="utf-8"?>
<!-- أداةُ الشاشة الرئيسيّة (SPEC §١٠٣ المرحلة A/5) — النصوصُ من الويب، ولا حسابَ هنا -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أرباح اليوم"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_earnings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_rides"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_toggle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="اتّصل"
        android:textColor="#FF1A1A1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/widget_button" />
</LinearLayout>
