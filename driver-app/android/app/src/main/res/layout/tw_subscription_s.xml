<?xml version="1.0" encoding="utf-8"?>
<!-- **ودجةُ TAXO «subscription_s»** — مولَّدٌ من tools/gen-android-widgets.py — لا يُحرَّر باليد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/tw_card" android:clipToOutline="true" android:layoutDirection="rtl">
    <ImageView android:id="@+id/tw_art" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="top|left" android:layout_marginTop="6dp" android:layout_marginEnd="4dp" android:src="@drawable/tw_il_calendar" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="12dp" android:paddingTop="12dp" android:paddingEnd="12dp" android:paddingBottom="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="7dp" android:src="@drawable/tw_g_receipt_long" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tw_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/tw_tx" android:textSize="13.5sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="اشتراكي" />
        </LinearLayout>
        <FrameLayout android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/tw_bigrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/tw_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="28sp" android:includeFontPadding="false" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
            <TextView android:id="@+id/tw_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="2dp" android:textColor="@color/tw_mut" android:textSize="13sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/tw_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/tw_mut" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:text="يظهر هنا ما بقي من اشتراكك" />
        <ProgressBar android:id="@+id/tw_bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" style="?android:attr/progressBarStyleHorizontal" android:max="100" android:progress="0" android:progressDrawable="@drawable/tw_bar" />
    </LinearLayout>
</FrameLayout>
