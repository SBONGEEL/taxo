<?xml version="1.0" encoding="utf-8"?>
<!-- **قبل الدخول** في ودجات TAXO — يملؤها `WidgetSignedOut` (العلامة وسطرٌ وزرّ). مولَّدٌ من tools/gen-android-widgets.py — لا يُحرَّر باليد. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/tw_root" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:background="@drawable/tw_card" android:clipToOutline="true">
<LinearLayout
    android:id="@+id/wo_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center" android:padding="12dp">
    <LinearLayout android:id="@+id/wo_col" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <ImageView android:layout_width="wrap_content" android:layout_height="22dp" android:adjustViewBounds="true" android:src="@drawable/tw_wordmark" android:contentDescription="TAXO" />
        <TextView android:id="@+id/wo_mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="1sp" android:includeFontPadding="false" android:visibility="gone"/>
        <TextView android:id="@+id/wo_line" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="13sp" android:includeFontPadding="false" android:layout_marginTop="8dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/wo_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="14sp" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="12dp" android:minWidth="150dp" android:minHeight="38dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="@drawable/tw_pill"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/wo_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:layout_width="wrap_content" android:layout_height="16dp" android:adjustViewBounds="true" android:src="@drawable/tw_wordmark" android:contentDescription="TAXO" />
            <TextView android:id="@+id/wo_mark2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_tx" android:textSize="1sp" android:includeFontPadding="false" android:visibility="gone"/>
            <TextView android:id="@+id/wo_line2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_mut" android:textSize="12sp" android:includeFontPadding="false" android:layout_marginTop="5dp" android:maxLines="2" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/wo_btn2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/tw_on" android:textSize="13.5sp" android:textStyle="bold" android:includeFontPadding="false" android:minHeight="36dp" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:background="@drawable/tw_pill"/>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
