<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <!-- **رؤيةُ الحزم على أندرويد ١١ فما فوق** (قِيس على S21، أندرويد ١٥):
         بلا هذا يعيد `canOpenUrl` **false لتطبيقٍ مثبَّتٍ فعلاً** — النظامُ
         يُخفي الحزمَ الأخرى عن التطبيق ما لم يعلن أنه يسألها. وهو عطبٌ صامت:
         لا استثناءَ ولا سطرَ سجلّ، فيُقرأ «غير مثبَّت» عن مثبَّت.

         والإعلانُ **بالحزمة وبالمخطط معاً**: الأولُ يكفي وهو الأضيق، والثاني
         يبقي الفحصَ عاملاً لو تبدّل اسمُ الحزمة يوماً. -->
    <queries>
        <package android:name="ly.tajora.rider" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taxo-rider" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- **الشاشة ٠٣ (شاشةٌ مقفلة) والشاشة ٠٤-البديل** من ملفّ التصميم
             `mobile-app-design-request` — **نشاطٌ أصليٌّ لا مسارُ ويب** (قرارُ
             المالك 2026-08-30): المقتولُ وبلا شبكةٍ لا يحمّل WebView، ومهلةُ
             القبول سبعُ ثوانٍ لا تكفي إقلاعَه.
             **و`showWhenLocked` مصرَّحٌ هنا** ليصل فوق القفل بلا فتحٍ يدويّ،
             **و`excludeFromRecents`** فلا تبقى بطاقةٌ منتهيةٌ في قائمة الأخيرة. -->
        <activity
            android:name=".OfferActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- **بابُ استقبال الجلسة المنقولة** (SPEC §23).

                 ومخططٌ خاصٌّ لا رابطُ تطبيق (App Link): الأخيرُ يحتاج ملفَّ
                 `assetlinks.json` على النطاق وتوقيعَ إصدارٍ مستقرّاً، وكلاهما
                 بندُ ما قبل الإطلاق (§18.1). والمرسِلُ يثبّت الحزمةَ في نيّته
                 (`package=`)، فلا يلتقط الرمزَ تطبيقٌ سجّل المخططَ نفسَه.

                 و`android:launchMode="singleTask"` أعلاه هو ما يجعل النيّةَ
                 تصل نشاطاً قائماً بدل أن تُنشئ ثانياً فوقه. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="taxo-driver" android:host="handoff" />
            </intent-filter>

        </activity>

        <!-- **خدمةُ الاستقبال** (2026-08-21): تبقي العمليةَ حيّةً ما دام
             الكبتنُ مستقبِلاً، فلا يسقط مقبسُه بعد ثوانٍ من إرسال التطبيق إلى
             الخلفية — وهو مقيسٌ على S21: أقلُّ من ٣٠ ثانية ثم `is_online=false`.
             و`stopWithTask=false` كي يبلغَها `onTaskRemoved` فتوقف نفسَها
             **وتزيل إشعارَها**، فلا يبقى سطرٌ يقول «تستقبل» ولا مقبسَ خلفه. -->
        <service
            android:name=".OnlineService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- الموقع: دقيقٌ وتقريبيٌّ معاً — أندرويد 12+ يعطي المستخدمَ خيارَ
         «تقريبي» ولو طلبتَ الدقيق، وطلبُ الدقيق وحدَه يترك من اختاره بلا
         موقعٍ إطلاقاً. والكبتنُ موقعُه هو الخدمة. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- **الموقعُ في الخلفية — للكبتن وحدَه** (تطبيقُ الراكب لا يطلبه ولا يحتاجه).
         وثلاثةُ أشياءَ يجب أن تُقال عنه بصراحة:
         ١. أندرويد 10+ **لا يمنحه من داخل التطبيق**: أقصى ما يستطيعه الحوارُ
            هو «أثناء الاستخدام»، و«السماح طوال الوقت» يُختار يدوياً من إعدادات
            النظام. فزرٌّ في التطبيق يَعِد به يَعِد بما لا يملكه.
         ٢. Google Play يقيّده بمراجعةٍ وسياسةٍ مكتوبة — وهذا بناءُ تصحيحٍ لا نشر.
         ٣. وبثُّ الموقع اليوم يقع والتطبيقُ مفتوح؛ البثُّ والشاشةُ مطفأةٌ يحتاج
            **خدمةً أماميةً** (foreground service) بإشعارٍ دائم، وهي بندٌ مستقلّ. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- **إذنا الخدمة الأمامية**: الأولُ عامٌّ منذ أندرويد 9، والثاني
         **يشترطه أندرويد 14 لكلِّ نوعٍ على حدة** — وبغيره يرمي النظامُ
         استثناءً لحظةَ `startForeground` لا عند التثبيت، أي **على جهاز
         الكبتن لا في البناء**. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- الإشعارات: إذنٌ صريحٌ منذ أندرويد 13 — ويُطلب عند أول حدثٍ يستحقّه
         لا عند الإقلاع: طلبٌ على شاشةٍ فارغةٍ يُرفض ثم لا يُسأل ثانية. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- **بطاقةُ طلبٍ تُقرأ والتطبيقُ مغلق** (قرارُ المالك 2026-08-30).
         **وهي وظيفةٌ أساسيّةٌ معلَنة** لا زينة: كبتنٌ يقود ولا يجوز أن يُطلب
         منه فتحُ تطبيقٍ ليعرف أنّ ثمّة عملاً — وهذا هو التعليلُ الذي يُقدَّم
         لمراجعة Play، مكتوباً **قبل الرفع لا بعد الرفض**.
         **ومن لم يمنحه لا يبقى بلا طريق**: `OfferAlert` ينتقل إلى إشعارٍ
         يملأ الشاشة، ولا تظهر الاثنتان معاً. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- **وأندرويد ١٤ فما فوق ينزع منحَه تلقائياً عن غير المكالمات والمنبّهات**
         (مقيسٌ من وثيقة أندرويد 2026-08-30) — فالتصريحُ لا يكفي، ويُسأل
         `canUseFullScreenIntent` ويُرسَل المستخدمُ إلى موضع المنح بيده. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- **إعفاءُ التوفير ليس إذناً بل شرطُ بقاءٍ للخدمة**: بدونه يُوقف
         النظامُ بثَّ الموقع بعد دقائق، **فيبدو الكبتنُ متصلاً وهو غائب** —
         وذاك أخطرُ من انقطاعٍ ظاهر. ولا يُطلب إلا من شاشة الأذونات. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
</manifest>
