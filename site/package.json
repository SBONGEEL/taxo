{
  "name": "taxo-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "صفحة taxo.tajora.ly — ناتجها ملفات ثابتة تُخدَم من landing/",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:commission-text": "node ../tools/check-commission-text.mjs",
    "check:shots": "node ../tools/check-shots.mjs",
    "build": "npm run assets && npm run check:site && npm run check:commission-text && npm run check:shots && vite build",
    "dev": "vite --host 0.0.0.0 --port 5177",
    "preview": "vite preview --host 0.0.0.0 --port 5177"
  },
  "devDependencies": {
    "sharp": "^0.34.2",
    "ttf2woff2": "^8.0.0",
    "vite": "^7.1.7"
  }
}
